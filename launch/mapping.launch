<launch>
  <!-- Build a map with GMapping. By default the robot explores on its own;
       set explore:=false and run turtlebot3_teleop in another terminal to drive by hand.
       People seen along the way are reported on /human_detection_alert. -->
  <arg name="model" default="waffle" doc="TurtleBot3 model [waffle, waffle_pi]"/>
  <arg name="world" default="$(find human_detector)/worlds/forest_people.world"/>
  <arg name="gui" default="true"/>
  <arg name="explore" default="true" doc="Wander autonomously while mapping"/>
  <arg name="detect" default="true" doc="Run the person tracker (no following)"/>
  <arg name="backend" default="yolo" doc="Person detector [yolo, hog]"/>

  <include file="$(find human_detector)/launch/simulation.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <include file="$(find turtlebot3_slam)/launch/turtlebot3_slam.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="slam_methods" value="gmapping"/>
    <arg name="open_rviz" value="true"/>
  </include>

  <node if="$(arg explore)" pkg="human_detector" type="explorer_node.py" name="explorer" output="screen">
    <rosparam command="load" file="$(find human_detector)/config/explorer.yaml"/>
    <remap from="scan" to="/scan"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node>

  <node if="$(arg detect)" pkg="human_detector" type="person_tracker_node.py" name="person_tracker" output="screen">
    <rosparam command="load" file="$(find human_detector)/config/tracker.yaml"/>
    <param name="backend" value="$(arg backend)"/>
    <remap from="image" to="/camera/rgb/image_raw"/>
  </node>
</launch>
