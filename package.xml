<?xml version="1.0"?>
<package format="2">
  <name>human_detector</name>
  <version>0.2.0</version>
  <description>
    Autonomous person detection, tracking and following for a TurtleBot3 in Gazebo.
    Detects people with YOLOv8 (or OpenCV HOG), tracks them across frames with persistent IDs,
    follows a chosen target using the camera and lidar, and maps the environment with GMapping SLAM.
  </description>

  <maintainer email="sriram.surya@icloud.com">Sriram</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/Sriram27102003/Autonomous-Drone-Target-Tracking-System</url>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Simulation, mapping and visualisation -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_slam</exec_depend>
  <exec_depend>turtlebot3_teleop</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>image_view</exec_depend>

  <!-- YOLOv8 comes from pip: pip3 install -r requirements.txt -->
</package>
