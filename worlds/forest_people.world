<?xml version="1.0"?>
<!-- Generated forest with walking people. Trees are simple primitives (no model downloads);
     people are Gazebo actors using the walk.dae animation that ships with Gazebo.
     Note: actors have no collision, so the lidar does not see them - the follower
     falls back to a camera-based distance estimate. -->
<sdf version="1.6">
  <world name="forest_people">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <shadows>false</shadows>
    </scene>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <model name="tree_1">
      <static>true</static>
      <pose>-2.5 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.1 1</ambient><diffuse>0.35 0.22 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
          <material><ambient>0.1 0.45 0.12 1</ambient><diffuse>0.1 0.45 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
